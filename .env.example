# ── Required ──────────────────────────────────────────────────────────────────

# Ollama endpoint (local LLM — no API key needed)
OLLAMA_HOST=http://your-ollama-host:11434

# Discord bot (optional — omit the bot service if not using Discord)
DISCORD_TOKEN=your_bot_token_here
DISCORD_CHANNEL_ID=your_channel_id_here

# ── Optional ──────────────────────────────────────────────────────────────────

# Ollama model (default: qwen2.5:3b — small, fast, good at JSON)
OLLAMA_MODEL=qwen2.5:3b

# Traefik hostname (default: ingest.lan)
INGEST_HOST=ingest.lan

# Timezone
TZ=UTC

# Path to SSH key on the host for mounting into the container
